# 环境变量示例：复制为 .env 后填入真实值
#
# ⚠️ 不要把填好真实密钥的 .env 提交到仓库（spec C-7 / C-8）。
# 本项目零第三方依赖，不会自动读取 .env 文件；
# 请把下面这些变量导出到 shell 环境中，或在启动时通过环境变量传入。
#
#   Windows PowerShell:
#     $env:LLM_API_KEY="sk-..."
#   Linux / macOS:
#     export LLM_API_KEY="sk-..."

# 必填：真实 LLM API 密钥
LLM_API_KEY=

# 可选：OpenAI 兼容的 API 基地址（默认 https://api.openai.com/v1）
LLM_BASE_URL=https://api.openai.com/v1

# 可选：模型名（默认 gpt-4o-mini）
LLM_MODEL=gpt-4o-mini

# 可选：单次请求超时秒数（默认 60）
LLM_TIMEOUT_SECONDS=60

# 可选：失败重试次数（默认 2 次重试，即最多 3 次尝试）
LLM_MAX_RETRIES=2
